# E8: LRU recorder + step timing, with the e8 MoE files mounted (λ and layer sizes unset = the released LRU).
QWEN38_RESEARCH=1
QWEN38_RESEARCH_LRU=1
QWEN38_RESEARCH_STEPMEM=0
QWEN38_RESEARCH_MEMSNAP=0
OVERLAY_OVERRIDES="model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_wna16.py=e8/compressed_tensors_moe_wna16.py model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/lru_map.py=e8/lru_map.py model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/stream_stage.py=e8/stream_stage.py"
