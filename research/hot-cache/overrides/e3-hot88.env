# E3 decode sweep: 128K context and 4,096-token chunks leave room for larger hot sets; decode at short context
# does not depend on the KV pool size.
MAX_MODEL_LEN=135168
KV_CACHE_MEMORY_BYTES=2500000000
MAX_NUM_BATCHED_TOKENS=4096
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=88
QWEN38_RESEARCH=1
QWEN38_RESEARCH_LRU=1
QWEN38_RESEARCH_STEPMEM=1
QWEN38_RESEARCH_MEMSNAP=0
