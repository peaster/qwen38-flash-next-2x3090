# E5: the 64 GB hot-only profile (static hot88 + CPU pool + GPU share 0.3) on this host, PLE from NVMe mmap.
QWEN38_PLE_GPU=
QWEN38_EMBED_UVA=0
QWEN38_RESEARCH=1
QWEN38_RESEARCH_LRU=1
QWEN38_RESEARCH_STEPMEM=0
QWEN38_RESEARCH_MEMSNAP=0
# The two 3090s only: .env lists them first and the PLE card last.
GPU_DEVICES=${GPU_DEVICES%,*}
