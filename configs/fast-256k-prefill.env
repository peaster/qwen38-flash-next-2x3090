# Prefill-leaning full-256K profile for 2x RTX 3090 on PCIe 4.0 x8 with the PLE table on a third GPU.
# Append to .env after configs/ple-gpu.env (fill in your GPU UUIDs). Measured 2026-10-03 on a Ryzen 9
# 7950X3D host with 2x RTX 3090 (NVLink, PCIe 4.0 x8 each) + RTX 5060 Ti 16 GB, 124 GiB RAM, 64 GB swap:
#   131,072 + 2,048: 3,976-4,196 input tok/s (TTFT 31-33 s), 72.0 tok/s decode; 128 + 256 x10: 71.3 tok/s;
#   262,016 + 128 boundary probe: 63.2 s to first token, zero preemptions, VRAM peak 23.6 GiB per card.
# The same host with the checked-in defaults at 2,048-token chunks measured 865 input tok/s and 67-71 decode.
# Every prefill chunk streams all cold experts once (~21 GB per GPU), so on an x8 link the chunk size is the
# lever: 8,192-token chunks need VRAM that hot84 does not leave at 256K (hot80 ran out of memory in the first
# chunk; 12,288-token chunks ran out at hot72). The input embedding moves to pinned host memory
# (QWEN38_EMBED_UVA, 1.27 GB of RAM) to keep 76 hot experts per layer and GPU.

# The fast 256K switches (see configs/fast-256k.env for what each does).
QWEN38_STREAM_STAGE=1
QWEN38_STREAM_STAGE_MIN_TOKENS=1536
QWEN38_STAGE_OVERLAP=1
QWEN38_ASYNC_SCHEDULING=1
QWEN38_TRITON_SKINNY=1
VLLM_MTP_DRAFT_VOCAB_RANGES=[[0,65536],[248044,248320]]
DISABLE_CUSTOM_ALL_REDUCE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
QWEN38_PLE_PREFAULT=1
JIT_CACHE_DIR=./jit-cache

# Prefill chunk size and the VRAM to afford it.
MAX_NUM_BATCHED_TOKENS=8192
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=76
# Input embedding in pinned host memory (UVA): frees 0.6 GB of VRAM per card for four more hot experts.
# Only with the PLE table on a third GPU (configs/ple-gpu.env); on a plain 128 GB host that RAM is not free.
QWEN38_EMBED_UVA=1
