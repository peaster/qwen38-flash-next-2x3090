# Optional 128K variant of configs/fast-256k-prefill.env for the same x8 host (PLE table on a third GPU).
# Append to .env after configs/ple-gpu.env and configs/fast-256k-prefill.env; the values below override it.
# Half the context (135,168 tokens) frees ~1.9 GB of KV pool per card, spent on 92 hot experts per layer and
# GPU on average. Measured 2026-10-25 (benchmarks/2026-10-25/): verify step -19 to -20% and decode +19-27%
# (89.8 held-out, 87.0 after 131K) versus the October 3 256K profile on the same day, 131,072-token prefill
# unchanged (3,981-4,342 tok/s). 96 slots and 100 ran out of VRAM in an 8,192-token chunk; 92 keeps ~280 MiB
# free at the worst chunk. Requests longer than 135,168 tokens are rejected.

MAX_MODEL_LEN=135168
# 110 blocks: 85 attention blocks, the QSA ring and 4 Mamba groups x 6 async prefill blocks (agent-128k).
KV_CACHE_MEMORY_BYTES=2500000000
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=92
QWEN38_LRU_LRFU_LAMBDA=0.95
QWEN38_HOT_CACHE_LAYER_SIZES=128,128,128,88,96,116,124,120,96,84,108,92,116,104,92,52,68,92,112,88,92,100,124,84,88,84,96,84,108,96,88,52,64,88,108,80,76,88,112,60,64,80,88,64,80,76,80,80
