# Opt-in: keep the PLE n-gram table on a third GPU that is not one of the two TP cards.
# Append to .env with your UUIDs from `nvidia-smi -L`. Needs an image built from this overlay.
#
# The PLE offload process binds to this GPU. As many 381 MiB checkpoint shards as fit in its
# memory (minus QWEN38_PLE_GPU_RESERVE_GIB, default 1) stay in VRAM; the other shards live once
# in exact-size pinned host memory that the same GPU reads through UVA. A 16 GB card holds 38
# of the 128 shards, so the table needs about 33.5 GiB of host RAM instead of 47.7 GiB.
QWEN38_PLE_GPU=GPU-00000000-0000-0000-0000-000000000000
# GPUs the container receives: the two TP cards first (they become CUDA devices 0 and 1 in bus
# order), then the PLE card. Required unless your CDI spec already lists all three under "all".
GPU_DEVICES=device=GPU-11111111-1111-1111-1111-111111111111,GPU-22222222-2222-2222-2222-222222222222,GPU-00000000-0000-0000-0000-000000000000
# Optional: fixed number of shards in that GPU's memory instead of the auto fit.
# QWEN38_PLE_GPU_SHARDS=38
# Optional: compare the first N lookups with the checkpoint rows (slow, startup self-check).
# QWEN38_PLE_GPU_VERIFY=3
